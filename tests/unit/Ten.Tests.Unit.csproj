<Project Sdk="Microsoft.NET.Sdk">

  <!--
    純粋層の単体テスト。Unity なしで `dotnet test` だけで走る。
    根拠: docs/40_test/harness.md 1 節（この二重化が純粋層の独立性のテストになっている）

    ここに UnityEngine への参照を足してはいけない。足した時点で
    「純粋層が環境に触っていない」ことを機械的に確かめる手段が消える。
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Ten.Tests.Unit</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <!--
    参照ベクタ。docs/40_test/harness.md 2 節が「これを正とする」と定めている。
    C# 実装が 1 件でも食い違ったら NFR-004 が成立しない。
  -->
  <ItemGroup>
    <None Include="../vectors/rng.json" Link="vectors/rng.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    純粋層。フェーズ 4 の時点では throw だけの空実装なので、
    テストは「ビルドは通り、実行して落ちる」状態になる。
    docs/00_process/test_first.md 5 節: 「落ちることを確認する。落ちないテストは何も検証していない」
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/Ten.Pure/Ten.Pure.csproj" />
  </ItemGroup>

</Project>
